{
  "name": "@forge/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "problems:import": "tsx src/cli/import-problems.ts",
    "replays:purge": "tsx src/cli/purge-replays.ts"
  },
  "dependencies": {
    "@forge/db": "workspace:*",
    "@forge/problem-kit": "workspace:*",
    "@forge/shared": "workspace:*",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "argon2": "0.45.1",
    "bullmq": "6.3.10",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "ioredis": "6.0.0",
    "nodemailer": "10.0.13",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@forge/config": "workspace:*",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "26.6.3",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
