# Production settings for the app VM. Copy to /etc/forge/forge.env, chmod 600, owner root.
# Never commit the real file. Generate secrets on the server:
#   openssl rand -base64 48   (APP_SECRET)      openssl rand -base64 32   (ENCRYPTION_KEY)
#   openssl rand -hex 32      (passwords, signing keys, METRICS_TOKEN)

# --- Compose (interpolation) ---
FORGE_DOMAIN=forge.example.com
ACME_EMAIL=you@example.com
FORGE_REGISTRY=ghcr.io/<github-user>/forge
POSTGRES_PASSWORD=
RUNNER_REDIS_API_PASSWORD=
RUNNER_REDIS_RUNNER_PASSWORD=
# Private-network IP of this VM that the runner VM connects to (never a public IP).
RUNNER_REDIS_BIND=10.0.0.2
# Origin for lab/preview iframes; empty until labs exist.
SANDBOX_ORIGIN=

# --- API ---
WEB_ORIGIN=https://forge.example.com
API_PUBLIC_URL=https://forge.example.com
APP_SECRET=
ENCRYPTION_KEY=
COOKIE_SECURE=true
RATE_LIMITS_ENABLED=true
HIBP_CHECK_ENABLED=true
# Transactional email provider (EU region). smtps://user:pass@host:465
SMTP_URL=
EMAIL_FROM="Forge <no-reply@forge.example.com>"
SECURITY_CONTACT_EMAIL=security@forge.example.com
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Same values on the runner VM. "keyId:secret", newest first (docs/runbooks/rotate-keys.md).
RUNNER_JOB_SIGNING_KEYS=
RUNNER_CALLBACK_KEYS=
S3_ENDPOINT=
S3_REGION=eu-central-1
S3_BUCKET=forge-private
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Stripe live mode (docs/runbooks/stripe.md).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_PRO_MONTHLY_REDUCED=
STRIPE_PRICE_PRO_YEARLY_REDUCED=
# Monitoring: at least one of these is required in production.
ALERT_EMAIL=
ALERT_WEBHOOK_URL=
METRICS_TOKEN=
