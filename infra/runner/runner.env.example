# /etc/forge/runner.env on the runner VM (mode 600, root). The only secrets this host gets.
NODE_ENV=production
RUNNER_ID=runner-1
# Restricted `runner` ACL user on the app VM's job Redis, over the private network.
RUNNER_REDIS_URL=redis://runner:<RUNNER_REDIS_RUNNER_PASSWORD>@10.0.0.2:6380/0
RUNNER_JOB_SIGNING_KEYS=
RUNNER_CALLBACK_KEYS=
RUNNER_CALLBACK_URL=https://forge.example.com/api/v1/internal/runner/callback
RUNNER_RUNTIME=runsc
RUNNER_CONCURRENCY=4
