# /etc/systemd/system/forge-runner.service (installed by infra/runner/install.sh)
[Unit]
Description=Forge code runner
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
User=forge-runner
Group=forge-runner
SupplementaryGroups=docker
EnvironmentFile=/etc/forge/runner.env
# Sandbox work dirs are bind-mounted into containers by the Docker daemon, so they must be on the
# real filesystem (not PrivateTmp).
Environment=TMPDIR=/var/lib/forge-runner/work
WorkingDirectory=/opt/forge-runner/current
ExecStart=/opt/forge-runner/current/bin/node dist/main.js
Restart=always
RestartSec=5
# Graceful: the worker finishes running jobs on SIGTERM.
TimeoutStopSec=60
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/forge-runner
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
