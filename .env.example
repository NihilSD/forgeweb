# Copy to .env (git-ignored). Never commit real secrets.
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Address shown on /security/rules for vulnerability reports (optional).
SECURITY_CONTACT_EMAIL=
API_PUBLIC_URL=http://localhost:4000
DATABASE_URL=postgresql://forge:forge@localhost:5432/forge
REDIS_URL=redis://localhost:6379/0
# Separate Redis (or separate DB/user) for runner jobs. Runner hosts get a restricted ACL user.
RUNNER_REDIS_URL=redis://localhost:6379/2
# Generate with: openssl rand -base64 48
APP_SECRET=change-me-change-me-change-me-change-me
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=change-me-base64-32-bytes-change-me-00000=
# Chrome accepts Secure cookies on http://localhost; keep true.
COOKIE_SECURE=true
TRUST_PROXY=false
RATE_LIMITS_ENABLED=true
# k-anonymity range check against Have I Been Pwned in addition to the bundled list.
HIBP_CHECK_ENABLED=false
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="Forge <no-reply@forge.local>"
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated "keyId:secret" pairs. The first key signs; all verify (rotation).
RUNNER_JOB_SIGNING_KEYS=k1:dev-job-signing-secret-change-me-000000
RUNNER_CALLBACK_KEYS=k1:dev-callback-secret-change-me-0000000000
# Runner host settings (apps/runner). Production requires runsc (gVisor); runc is for dev machines.
RUNNER_CALLBACK_URL=http://localhost:4000/api/v1/internal/runner/callback
RUNNER_RUNTIME=runc
RUNNER_CONCURRENCY=4
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-1
S3_BUCKET=forge-private
S3_ACCESS_KEY=forge
S3_SECRET_KEY=forge-dev-secret
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
# Where the Next.js server reaches the API (server-side fetches and the /api/v1 proxy).
API_INTERNAL_URL=http://localhost:4000
# Origin allowed in frame-src for lab/preview iframes (separate sandbox domain). Empty = none.
SANDBOX_ORIGIN=
