{
  "name": "forge",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:services": "docker compose -f infra/docker-compose.dev.yml up -d",
    "build": "turbo run build",
    "lint": "turbo run build --filter=./packages/* && eslint . && turbo run typecheck",
    "typecheck": "turbo run typecheck",
    "test": "turbo run build --filter=./packages/* && turbo run test --concurrency=1",
    "test:e2e": "pnpm --filter @forge/web test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @forge/db migrate:dev",
    "db:deploy": "pnpm --filter @forge/db migrate:deploy",
    "db:seed": "pnpm --filter @forge/db seed",
    "problems:validate": "pnpm --filter @forge/problem-kit build && pnpm --filter @forge/problem-kit exec node dist/cli.js validate ../../content/problems",
    "problems:import": "pnpm --filter @forge/api problems:import"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "turbo": "2.11.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
