// Forge data model. See docs/SPEC.pdf section 4.
// Every model has id (UUID), createdAt and updatedAt.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- L2: accounts

enum UserRole {
  user
  content_editor
  moderator
  support
  superadmin
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  /// Always stored lower-cased.
  email               String    @unique
  emailVerifiedAt     DateTime?
  passwordHash        String?
  displayName         String?
  handle              String?   @unique
  avatarKey           String?
  country             String?   @db.Char(2)
  timeZone            String    @default("UTC")
  role                UserRole  @default(user)
  birthYear           Int?
  goal                String?
  languages           String[]  @default([])
  onboardedAt         DateTime?
  emailDigestOptIn    Boolean   @default(false)
  /// Local week (Monday, YYYY-MM-DD) of the last weekly progress email sent.
  digestSentWeek      String?
  failedLoginCount    Int       @default(0)
  lockedUntil         DateTime?
  deletionRequestedAt DateTime?
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sessions          Session[]
  submissions       Submission[]
  drafts            Draft[]
  flagSubmissions   FlagSubmission[]  @relation("FlagSubmitter")
  oauthAccounts     OAuthAccount[]
  totpSecret        TotpSecret?
  recoveryCodes     RecoveryCode[]
  emailTokens       EmailToken[]
  auditLogs         AuditLog[]        @relation("AuditActor")
  hintUses          HintUse[]
  problemProgresses ProblemProgress[]
  bookmarks         Bookmark[]
  notes             Note[]
  masteries         Mastery[]
  reviewItems       ReviewItem[]
  lessonProgresses  LessonProgress[]
  attempts          Attempt[]
  reviewsGiven      Review[]          @relation("Reviewer")
  xpEvents          XpEvent[]
  streak            Streak?
  placement         PlacementResult?
  billingCustomer   BillingCustomer?
  subscriptions     Subscription[]
  entitlement       Entitlement?

  @@index([deletionRequestedAt])
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// sha256 of the cookie token. The raw token is never stored.
  tokenHash         String    @unique
  expiresAt         DateTime
  lastSeenAt        DateTime  @default(now())
  userAgent         String?
  ipHash            String?
  /// False while a password login waits for the TOTP step.
  twoFactorVerified Boolean   @default(true)
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId])
}

model OAuthAccount {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String
  providerUserId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([provider, providerUserId])
  @@index([userId])
}

model TotpSecret {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @db.Uuid
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// AES-256-GCM encrypted base32 secret.
  encryptedSecret String
  enabledAt       DateTime?
  /// Last accepted 30s time step, to reject code replay.
  lastUsedStep    Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model RecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
}

enum EmailTokenKind {
  verify_email
  reset_password
}

model EmailToken {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @db.Uuid
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      EmailTokenKind
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([userId, kind])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @db.Uuid
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  target    String?
  ipHash    String?
  meta      Json?
  at        DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([actorId, at])
  @@index([action, at])
}

// ---------------------------------------------------------------- L3: problems

model Track {
  id        String           @id @default(uuid()) @db.Uuid
  slug      String           @unique
  name      String
  order     Int
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  problems  Problem[]
  dailies   DailyChallenge[]
}

enum ProblemStatus {
  draft
  published
  retired
}

enum ReviewStatus {
  needs_review
  approved
}

enum ProblemMode {
  practice
  competitive
  both
}

enum Difficulty {
  easy
  medium
  hard
  expert
}

model Problem {
  id                String                   @id @default(uuid()) @db.Uuid
  slug              String                   @unique
  trackId           String                   @db.Uuid
  track             Track                    @relation(fields: [trackId], references: [id])
  title             String
  difficulty        Difficulty
  /// Starts from difficulty (spec 8); recalculated weekly from verified solve rates (v1).
  rating            Int
  tags              String[]
  formats           String[]
  languages         String[]
  mode              ProblemMode
  status            ProblemStatus            @default(draft)
  reviewStatus      ReviewStatus             @default(needs_review)
  /// Current version number (ProblemVersion.version).
  version           Int
  publishedAt       DateTime?
  /// False for lesson exercises: reachable from lessons, hidden from the library.
  listed            Boolean                  @default(true)
  /// Title, tags and slug, maintained by the importer; source of `search`.
  searchText        String                   @default("")
  /// Generated tsvector (see the l3 migration); read-only.
  search            Unsupported("tsvector")? @default(dbgenerated("to_tsvector('simple'::regconfig, \"searchText\")"))
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  versions          ProblemVersion[]
  submissions       Submission[]
  drafts            Draft[]
  flagIssues        FlagIssue[]
  flagSubmissions   FlagSubmission[]
  hintUses          HintUse[]
  problemProgresses ProblemProgress[]
  bookmarks         Bookmark[]
  notes             Note[]
  reviewItems       ReviewItem[]
  attempts          Attempt[]
  dailies           DailyChallenge[]

  @@index([trackId, status])
  @@index([status, difficulty])
  @@index([search], type: Gin)
}

/// Everything needed to serve and grade one version of a package. Fields marked SERVER-ONLY
/// must never be sent to clients (hidden tests are produced by `moduleCode`).
model ProblemVersion {
  id               String    @id @default(uuid()) @db.Uuid
  problemId        String    @db.Uuid
  problem          Problem   @relation(fields: [problemId], references: [id], onDelete: Cascade)
  version          Int
  packageHash      String
  /// Statement markdown with {{placeholders}}.
  statement        String
  limits           Json
  /// problem.yaml as parsed (entry, comparator, verifiedMinutes, ...).
  manifest         Json
  /// Starter templates per language.
  starters         Json
  hints            Json
  editorial        String
  /// SERVER-ONLY: reference solutions per language.
  references       Json
  /// SERVER-ONLY: bundled generator/tests/followups (ESM).
  moduleCode       String
  validationReport Json?
  publishedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([problemId, version])
  @@index([packageHash])
}

// ---------------------------------------------------------------- L4: submissions

enum SubmissionKind {
  run
  submit
}

enum SubmissionStatus {
  queued
  running
  done
}

enum Verdict {
  accepted
  wrong_answer
  time_limit
  memory_limit
  output_limit
  runtime_error
  compile_error
  internal_error
}

model Submission {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId      String           @db.Uuid
  problem        Problem          @relation(fields: [problemId], references: [id], onDelete: Cascade)
  version        Int
  language       String
  code           String
  kind           SubmissionKind
  status         SubmissionStatus @default(queued)
  verdict        Verdict?
  runtimeMs      Int?
  memoryKb       Int?
  testsPassed    Int?
  testsTotal     Int?
  /// Instance seed the tests were generated from (hidden tests are regenerated, never stored).
  seed           Int
  /// Custom-input runs: the arguments the user supplied.
  customInput    Json?
  /// Graded, client-safe view: visible test details and hidden categories only.
  result         Json?
  /// Current runner job id; a callback for any other id is rejected.
  jobId          String?          @unique
  attempts       Int              @default(0)
  idempotencyKey String?
  /// Verified attempt (phase L8).
  attemptId      String?          @db.Uuid
  finishedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([userId, problemId, createdAt])
  @@index([status, createdAt])
}

// ---------------------------------------------------------------- L5: workspace

/**
 * Autosaved editor contents, one per user, problem and language.
 */
model Draft {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId String   @db.Uuid
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  language  String
  code      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, problemId, language])
}

// ---------------------------------------------------------------- L5/L7: flag challenges

/// Which flag was issued to which user, so a flag submitted by someone else can be traced
/// (spec 3.4: a flag from the wrong user is recorded as a sharing signal).
model FlagIssue {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  problemId String   @db.Uuid
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  /// sha256 of the flag; the flag itself is never stored.
  flagHash  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, problemId])
}

model FlagSubmission {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation("FlagSubmitter", fields: [userId], references: [id], onDelete: Cascade)
  problemId  String   @db.Uuid
  problem    Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  valueHash  String
  correct    Boolean
  /// Set when the value is another user's flag.
  sharedFrom String?  @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, problemId])
  @@index([sharedFrom])
}

// ---------------------------------------------------------------- L6: practice

/// One revealed hint level. `day` is the user's local date (YYYY-MM-DD) for daily limits.
model HintUse {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId String   @db.Uuid
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  level     Int
  day       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, problemId, level])
  @@index([userId, day])
}

/// Practice state per user and problem (drives XP, mastery and the review queue).
model ProblemProgress {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId     String    @db.Uuid
  problem       Problem   @relation(fields: [problemId], references: [id], onDelete: Cascade)
  failedSubmits Int       @default(0)
  solvedAt      DateTime?
  gaveUpAt      DateTime?
  /// Hint levels used before the first solve (for XP and mastery).
  hintsAtSolve  Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, problemId])
}

model Bookmark {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId String   @db.Uuid
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, problemId])
}

model Note {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId String   @db.Uuid
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, problemId])
}

/// Spec 8: mastery per concept tag, levels 0-5 (derived from `points`, 20 per level).
model Mastery {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag           String
  points        Int       @default(0)
  level         Int       @default(0)
  lastPracticed DateTime?
  nextReviewAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, tag])
}

/// Spec 8: struggled problems come back after 2, 7 and 21 days.
model ReviewItem {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId   String    @db.Uuid
  problem     Problem   @relation(fields: [problemId], references: [id], onDelete: Cascade)
  /// 0, 1, 2 = waiting for the 2/7/21-day review; 3 = finished.
  stage       Int       @default(0)
  dueAt       DateTime
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, problemId])
  @@index([userId, dueAt])
}

model Course {
  id           String        @id @default(uuid()) @db.Uuid
  slug         String        @unique
  title        String
  description  String
  /// Language or track this course belongs to.
  topic        String
  order        Int
  kind         String        @default("course")
  status       ProblemStatus @default(draft)
  reviewStatus ReviewStatus  @default(needs_review)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  lessons      Lesson[]
}

model Lesson {
  id           String           @id @default(uuid()) @db.Uuid
  courseId     String           @db.Uuid
  course       Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  slug         String
  title        String
  order        Int
  concepts     String[]
  /// Markdown body with ```exercise / ```visualizer blocks.
  body         String
  reviewStatus ReviewStatus     @default(needs_review)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  progress     LessonProgress[]

  @@unique([courseId, slug])
}

model LessonProgress {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String   @db.Uuid
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, lessonId])
}

// ---------------------------------------------------------------- L8: verified attempts

enum AttemptStatus {
  in_progress
  followups
  verified
  unverified
  review
  appealed
  expired
}

/// Spec 7.1: one verified attempt on a unique instance of a template.
model Attempt {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @db.Uuid
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId       String         @db.Uuid
  problem         Problem        @relation(fields: [problemId], references: [id], onDelete: Cascade)
  version         Int
  language        String
  /// Random instance seed, stored as int32 and read back with >>> 0.
  seed            Int
  /// sha256 of the instance parameters, so two users don't get the same instance.
  instanceHash    String
  /// Consent is given for every attempt (spec 3.2).
  consentAt       DateTime
  startedAt       DateTime
  endsAt          DateTime
  submittedAt     DateTime?
  /// The accepted submission that ended the coding phase.
  submissionId    String?        @unique @db.Uuid
  /// Percentage of tests passed by the best submission.
  score           Int?
  integrityScore  Int?
  /// Integrity signal breakdown. Moderators only.
  signals         Json?
  status          AttemptStatus  @default(in_progress)
  finishedAt      DateTime?
  /// Spec 3.2: replays are deleted after 12 months unless the user keeps them public.
  replayPublic    Boolean        @default(false)
  replayDeletedAt DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  events          AttemptEvent[]
  followUps       FollowUp[]
  reviews         Review[]
  appeal          Appeal?

  @@index([userId, startedAt])
  @@index([problemId, status])
  @@index([problemId, instanceHash])
  @@index([status, submittedAt])
}

/// Spec 7.2: recorded events, stored compressed. Client batches carry `seq` (idempotent retries);
/// server-recorded events (runs, submits, follow-up answers) have no `seq`.
model AttemptEvent {
  id        String   @id @default(uuid()) @db.Uuid
  attemptId String   @db.Uuid
  attempt   Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  seq       Int?
  /// client | server
  source    String
  /// Milliseconds since the attempt started, of the first event in the payload.
  t         Int
  /// batch (client) | run | submit | followup (server)
  type      String
  count     Int
  /// gzip-compressed JSON array of events.
  payload   Bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attemptId, seq])
  @@index([attemptId, t])
}

/// Spec 7.3: a follow-up question, graded against the user's own code.
model FollowUp {
  id         String    @id @default(uuid()) @db.Uuid
  attemptId  String    @db.Uuid
  attempt    Attempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  kind       String
  prompt     String
  options    Json?
  /// SERVER-ONLY: accepted answers, derived from the user's own code.
  expected   Json
  order      Int
  shownAt    DateTime?
  answer     String?
  correct    Boolean?
  answeredMs Int?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([attemptId, questionId])
}

/// A moderator's decision on an attempt in review or under appeal.
model Review {
  id         String   @id @default(uuid()) @db.Uuid
  attemptId  String   @db.Uuid
  attempt    Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  reviewerId String?  @db.Uuid
  reviewer   User?    @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  /// verified | unverified
  decision   String
  notes      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([attemptId])
}

enum AppealOutcome {
  pending
  upheld
  denied
}

/// One appeal per attempt (spec 7.4: users can appeal any non-verified result).
model Appeal {
  id        String        @id @default(uuid()) @db.Uuid
  attemptId String        @unique @db.Uuid
  attempt   Attempt       @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  reason    String
  /// Status before the appeal, restored if it is denied.
  previous  AttemptStatus
  outcome   AppealOutcome @default(pending)
  decidedAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

// ---------------------------------------------------------------- L9: daily, XP, streaks, placement

/// Spec 8: one daily challenge per track per UTC date.
model DailyChallenge {
  id        String   @id @default(uuid()) @db.Uuid
  /// UTC date, YYYY-MM-DD.
  date      String
  trackId   String   @db.Uuid
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  problemId String   @db.Uuid
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, trackId])
  @@index([problemId])
}

/// Every XP award. `sourceKey` makes each award happen once (e.g. solve:<problemId>).
model XpEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  /// solve | lesson | daily
  reason    String
  sourceKey String
  at        DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, sourceKey])
  @@index([userId, at])
}

/// Spec 8: streak state, in the user's local days.
model Streak {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  current     Int      @default(0)
  longest     Int      @default(0)
  lastDay     String?
  freezeMonth String?
  freezesUsed Int      @default(0)
  frozenDays  String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Placement quiz questions, imported from content/placement/quiz.yaml.
model PlacementQuestion {
  id        String   @id
  order     Int
  tag       String
  prompt    String
  options   String[]
  /// SERVER-ONLY: index of the correct option.
  answer    Int
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One placement result per user (taken or skipped).
model PlacementResult {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skipped   Boolean  @default(false)
  score     Int      @default(0)
  total     Int      @default(0)
  /// Question id → chosen option index.
  answers   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------- L10: billing

/// Links a user to their Stripe customer.
model BillingCustomer {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @db.Uuid
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId String   @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// Mirror of a Stripe subscription, updated only from verified webhooks.
model Subscription {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @db.Uuid
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeSubscriptionId String    @unique
  /// Stripe status: active, trialing, past_due, unpaid, canceled, incomplete, …
  status               String
  priceId              String?
  interval             String?
  currency             String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  /// Spec 10: after a failed payment Pro stays until this time (7 days).
  graceUntil           DateTime?
  /// `created` (Unix seconds) of the last subscription event applied; older events are stale.
  lastEventAt          Int       @default(0)
  /// `created` of the last invoice event applied (paid / payment_failed).
  invoiceEventAt       Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId])
}

/// The plan a user is entitled to, recomputed from their subscriptions after every event.
model Entitlement {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @unique @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan       String
  /// Null = no end (active subscription). Otherwise Pro lapses at this time (grace, cancel).
  validUntil DateTime?
  source     String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

/// Every verified webhook, stored once by event id and processed through the queue.
model WebhookEvent {
  id          String    @id @default(uuid()) @db.Uuid
  provider    String    @default("stripe")
  eventId     String    @unique
  type        String
  /// Event `created`, Unix seconds.
  created     Int
  payload     Json
  /// received | processed | ignored | failed
  status      String    @default("received")
  attempts    Int       @default(0)
  error       String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, createdAt])
}
